{
  "name": "ecommerce-app",
  "private": true,
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "frontend:install": "npm --prefix frontend install",
    "backend:install": "./.venv/bin/python -m pip install -r backend/requirements.txt",
    "backend:dev": "./.venv/bin/python -m uvicorn backend.app.main:app --reload --host 0.0.0.0 --port 8000",
    "backend:setup": "python3 -m venv .venv"
  }
}
